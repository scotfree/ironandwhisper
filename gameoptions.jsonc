{
  // option ids should be between 100 and 199
  // See https://en.doc.boardgamearena.com/Options_and_preferences:_gameoptions.json,_gamepreferences.json for more details

  // Which player takes which side. The sides are deeply asymmetric, so this is
  // not a cosmetic choice: the Empire moves visible troops, the Insurgency
  // seeds hidden cards. Stored per player in `player.player_side` at setup.
  "100": {
    "name": "Side assignment",
    "values": {
      "0": {
        "name": "Random"
      },
      "1": {
        "name": "First player is the Empire",
        "description": "The player in the first seat commands the Empire.",
        "tmdisplay": "First player is the Empire"
      },
      "2": {
        "name": "First player is the Insurgency",
        "description": "The player in the first seat leads the Insurgency.",
        "tmdisplay": "First player is the Insurgency"
      }
    },
    "default": 0
  },

  // Which bot a solo game plays against. The two are genuinely different
  // opponents rather than difficulty multipliers: Glob plays for its supply
  // network and takes only fights it is certain of, and beats the Heuristic
  // bot's own side about 64% of the time in self-play. Heuristic is kept
  // because it is the port's reference implementation and the weaker game.
  "101": {
    "name": "Bot opponent",
    "values": {
      "0": {
        "name": "Glob",
        "description": "Resolves only battles it is certain of, spreads outward to widen its supply, and withdraws a garrison it cannot save.",
        "tmdisplay": "Glob bot"
      },
      "1": {
        "name": "Heuristic",
        "description": "Marches at the tallest pile it can see and resolves when it likes the odds. The weaker opponent.",
        "tmdisplay": "Heuristic bot"
      },
      "2": {
        "name": "Glob2",
        "description": "Glob, with a much tighter leash on any garrison standing apart from its main army.",
        "tmdisplay": "Glob2 bot"
      },
      "3": {
        "name": "Imperial Monolith",
        "description": "Keeps every troop in one army, walks it onto piles it is certain to beat, and never leaves a garrison where a visible pile could take it. The strongest Empire bot when only captured presence scores.",
        "tmdisplay": "Imperial Monolith bot"
      },
      "4": {
        "name": "MonoLoc",
        "description": "The Imperial Monolith, playing for ground: it sends single troops to claim every open location it can certainly hold. The strongest Empire bot when locations score.",
        "tmdisplay": "MonoLoc bot"
      }
    },
    "default": 0,
    "displaycondition": [
      {
        "type": "maxplayers",
        "value": 1
      }
    ]
  },

  // The same choice on the other side, for a solo game as the Empire. Mist
  // reads the geography rather than the arithmetic: it cashes every town it
  // has already won, takes a lead only where the Empire has no troops in
  // reach of answering it, and spends its bluffs on empty ground beside a
  // garrison. It takes every game off the Glob bot in self-play, where the
  // Heuristic rebels lose about 63% of them.
  "102": {
    "name": "Rebel bot",
    "values": {
      "0": {
        "name": "Mist",
        "description": "Cashes every town it has already won, takes leads the Empire cannot answer next turn, and seeds its bluffs where troops are about to arrive.",
        "tmdisplay": "Mist bot"
      },
      "1": {
        "name": "Heuristic",
        "description": "Piles presence onto the richest garrison it can see and scatters the rest at random. The weaker opponent.",
        "tmdisplay": "Heuristic rebels"
      },
      "2": {
        "name": "Mist2",
        "description": "Mist, leading with the richest garrison it can reach instead of the safest one.",
        "tmdisplay": "Mist2 bot"
      }
    },
    "default": 0,
    "displaycondition": [
      {
        "type": "maxplayers",
        "value": 1
      }
    ]
  },

  // Whether winning a resolution also scores the location itself (issue #1).
  // Capture-only scoring is the default and the game as it has always been;
  // location value is the experiment, offered beside it so both can be played.
  // Applies to every table, solo or not.
  "103": {
    "name": "Scoring",
    "values": {
      "0": {
        "name": "Presence only",
        "description": "Winning a location scores the presence taken off the other side, and nothing more."
      },
      "1": {
        "name": "Presence and locations",
        "description": "Winning a location also scores its value: 1 point each, to either side.",
        "tmdisplay": "Locations score",
        "nobeginner": true
      }
    },
    "default": 0
  },

  // Whether the rebels may keep cards in hand (Decision 6 relaxed). They draw
  // the same number every turn whatever they hold, so the deck is still an
  // exact clock, and may place any part of the hand or none of it. Cards still
  // in hand when the deck runs out are never played.
  "104": {
    "name": "Rebels can hold cards",
    "values": {
      "0": {
        "name": "No",
        "description": "The Rebels must place their whole hand every turn."
      },
      "1": {
        "name": "Yes",
        "description": "The Rebels draw the same number every turn and may place any of their hand, or none of it.",
        "tmdisplay": "Rebels can hold cards",
        "nobeginner": true
      }
    },
    "default": 0
  },

  // A bucket for rules beyond the base game (issue #6). Currently adds one
  // thing: before anything else happens, a human Rebel player may arrange
  // their deck in any order, or shuffle it again. The Empire is never told
  // whether this ran or what came of it — it never sees the deck either way,
  // arranged or not. Does nothing in a game where a bot plays the Rebels.
  "105": {
    "name": "Advanced rules",
    "values": {
      "0": {
        "name": "Off",
        "description": "The deck is shuffled once and play begins immediately."
      },
      "1": {
        "name": "On",
        "description": "A human Rebel player may arrange the deck, or shuffle it again, before play begins.",
        "tmdisplay": "Advanced rules",
        "nobeginner": true
      }
    },
    "default": 0
  }
}
